# 5s app environment — copy to `5s/.env` and fill in the secrets.
# Loaded by `5s/start.sh` via `set -a; . .env; set +a` so child processes
# inherit every assignment.

# ── Postgres (REQUIRED) ───────────────────────────────────────────────
# Direct connection string to the Supabase Postgres for the 5s schema.
# Use the *direct* connection (port 5432), not the pooled one — Drizzle
# migrations need a real session for advisory locks.
DATABASE_URL=postgres://postgres:<password>@<project>.supabase.co:5432/postgres

# ── Auth (REQUIRED) ───────────────────────────────────────────────────
# Used to sign JWT session cookies. Generate with: `openssl rand -hex 48`.
SESSION_SECRET=replace-me

# ── Public URL (REQUIRED for emails / Slack links) ────────────────────
APP_BASE_URL=https://5s.mygranules.com

# ── VLM (OpenAI-compatible) — required for AI scoring / labelling ─────
# Without these, scoring falls back to CLIP-similarity-only.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-5-mini

# ── Notifications (optional) ──────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=no-reply@mygranules.com
SLACK_WEBHOOK_URL=

# ── Misc (optional — sensible defaults already in code) ───────────────
NODE_ENV=production
LOG_LEVEL=info
SHIFT_TIMEZONE=Asia/Kolkata
